  "root_cause": {
    "summary": "BusyBox declares ptr_to_globals as a const pointer but modifies it through an alias. In vi INIT_G, Clang 23.1.1 -Oz hoists the old pointer load before assignment, then accesses last_modified_count through that stale null pointer.",
    "fault": {
      "epc": "0x831bc",
      "ra": "0x831ac",
      "badaddr": "0x24",
      "cause": 13,
      "s4": 0,
      "a0": "0x9575a020",
      "ptr_to_globals_address": "0x1839e4",
      "vi_main_address": "0x83184"
    },
    "field": "struct globals.last_modified_count, offset 0x24",
    "exact_original_rootfs_code_matches_unstripped_elf": true,
    "compared_virtual_address_range": [
      "0x83184",
      "0x83200"
    ],
    "original_instruction_chain": [
      {
        "pc": "0x831a8",
        "instruction": "jal xzalloc",
        "meaning": "Allocates 0x1638 zeroed bytes; board a0=0x9575a020 is nonnull."
      },
      {
        "pc": "0x831b4",
        "instruction": "lw s4,0(a1)",
        "meaning": "Loads old ptr_to_globals value, zero, from address 0x1839e4."
      },
      {
        "pc": "0x831b8",
        "instruction": "sw a0,0(a1)",
        "meaning": "Installs the new allocation after the stale pointer was loaded."
      },
      {
        "pc": "0x831bc",
        "instruction": "lw a0,0x24(s4)",
        "meaning": "Dereferences stale null+0x24; matches cause13, badaddr0x24 and s4=0."
      }
    ],
    "source_excerpts": [
      {
        "artifact": "frozen_inputs.vi_source",
        "lines": [
          544,
          546
        ],
        "text": "#define INIT_G() do { \\\n\tSET_PTR_TO_GLOBALS(xzalloc(sizeof(G))); \\\n\tlast_modified_count--; \\"
      },
      {
        "artifact": "frozen_inputs.libbb_header",
        "lines": [
          378,
          380
        ],
        "text": " * However, this may break on weird arches or toolchains. In this case,\n * set \"-DBB_GLOBAL_CONST=''\" in CONFIG_EXTRA_CFLAGS to disable\n * this optimization."
      },
      {
        "artifact": "frozen_inputs.libbb_header",
        "lines": [
          2297,
          2297
        ],
        "text": "extern struct globals *BB_GLOBAL_CONST ptr_to_globals;"
      },
      {
        "artifact": "frozen_inputs.libbb_header",
        "lines": [
          2319,
          2322
        ],
        "text": "/* XZALLOC_CONST_PTR() is an out-of-line function to prevent\n * clang from reading pointer before it is assigned.\n */\nvoid XZALLOC_CONST_PTR(const void *pptr, size_t size) FAST_FUNC;"
      }
    ],
    "compiler_only_proof": {
      "source_changes": false,
      "extra_flag": "-DBB_GLOBAL_CONST=",
      "compile_exit_code": 0,
      "before_object_offsets": "0x38 loads old pointer; 0x3c installs allocation; 0x40 dereferences old pointer.",
      "after_object_offsets": "0x3c installs allocation; 0x40 reloads installed pointer; 0x44 dereferences it."
    },
    "classification": "Reproduces under QEMU user emulation with the identical BusyBox binary; FPGA-specific memory or pipeline behavior is not required to reproduce this failure."
  },
  "production_fix": {
    "path": "sim/build_linux.sh",
